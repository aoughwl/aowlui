## component.aowl — the new component shape, end to end.
##
##   ./run.sh scripts/component.aowl
##
## This is the form we want the UI pack to normalize around:
##   component something:
##     input name: string = ""
##     box:
##       h1 "test"
##       style:
##         color: red
##         [hover]:
##           opacity: 0.5
##
## The current compiler accepts the typed `input` form without the default suffix,
## so the executable demo below uses that supported subset.

import std/syncio
import aoughwl/component
import aoughwl/web

component something:
  input name: string
  box:
    h1 "test"
    style:
      color: red
      [hover]:
        opacity: 0.5

echo "── component renders with inline styling ──"
echo render(something(name = ""))

echo ""
echo "── atomized component graph ──"
echo "  something uses:"
for c in uses("something"):
  echo "    → ", c

echo ""
echo "── canonical identity ──"
echo "  something canonical id: ", canonicalId("something")
